# ------------------------------------------------------------------
# Constellation — environment template. Copy to `.env` (git-ignored).
# NEVER commit real secrets. Values here are safe placeholders.
# ------------------------------------------------------------------

# --- Core API (NestJS) ---
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api
# Comma-separated allowed origins for CORS
# NOTE: :3005 is the documented WEB_HOST_PORT dev-port remap on hosts where
# :3000 is taken (see the web section below) — the portal MUST be CORS-allowed
# or the IdentityBanner probe fails and falsely reports the wrong API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# --- Web portal (Next.js) ---
# WARNING (verified 2026-08-02): port 4000 is a common collision on dev hosts.
# If something else already owns :4000 (e.g. a LiteLLM gateway from another
# project), the portal does NOT fail loudly — that process answers with a valid
# HTTP response such as {"detail":"Not Found"}, so the UI silently talks to the
# wrong product's API and shows confusing errors instead of a connection error.
# The portal's API base (used by every client in apps/web/src/lib via the
# shared api-base.ts helper, and by next.config.mjs's /api dev proxy). The
# api is published on 4001 — port 4000 is a KNOWN local hazard: a foreign
# process (e.g. Looper's LiteLLM gateway) squats it and answers with valid
# HTTP that is NOT this product (see GET /api/identity — the portal asserts
# it on load and shows a "wrong API" banner if it doesn't match). If the
# portal behaves oddly, check who owns the port first:
#   docker ps --filter publish=4000     /     netstat -ano | grep :4000
# Then remap BOTH of these together (API_HOST_PORT must match the URL below):
#   API_HOST_PORT=4010
#   NEXT_PUBLIC_API_URL=http://localhost:4010/api
NEXT_PUBLIC_API_URL=http://localhost:4001/api
# The P3 federated tool catalog is served by the API from its own registry
# (config/modules.yaml) at GET /api/federation/modules — the portal does not read
# modules.yaml directly. No extra env var is needed for federation.

# --- Database (PostgreSQL) — wired in a later phase ---
DATABASE_URL=postgresql://constellation:constellation@localhost:5432/constellation

# --- Cache (Redis) — later phase ---
REDIS_URL=redis://localhost:6379
# Engine v0.1: the durable task runtime degrades like the rest of the platform.
# If REDIS_URL is unset or Redis is unreachable at boot, the engine DISABLES
# itself with an honest reason — the api still boots healthy, GET /api/engine/health
# reports engine:"unavailable" + a reason, and POST /api/engine/tasks returns a
# clean 503 instead of hanging. Redis connection options are fail-fast (bounded
# retries + connect timeout), so a dead Redis never becomes a log flood.

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
# Seeded on first boot WITH a database (skipped, with a warning, when there is no DB).
ADMIN_EMAIL=admin@constellation.local
ADMIN_PASSWORD=changeme
# A non-admin `viewer` user is seeded alongside the admin (Platform hardening v0.6)
# so the RBAC 403 path is live-testable — its JWT carries only `core:authenticated`,
# so any admin-only route returns 403 for it. Override with the same `changeme`
# dev-default caveat as the admin account.
VIEWER_EMAIL=viewer@constellation.local
VIEWER_PASSWORD=changeme
# httpOnly auth-cookie name (Platform hardening v0.6). The access token is ALSO
# set as an httpOnly, SameSite=Lax cookie (`Secure` only in production) — additive
# to the existing bearer-token response body. The name is configurable so operators
# can avoid collisions. Optional.
AUTH_COOKIE_NAME=constellation_token
# Plugin health poll cadence (ms); 0 disables polling.
PLUGIN_HEALTH_POLL_INTERVAL_MS=30000
PLUGIN_HEALTH_POLL_TIMEOUT_MS=5000

# --- Plugin loader ---
# Directory (relative to repo root) scanned for installed plugins.
PLUGINS_DIR=plugins

# ------------------------------------------------------------------
# ENGINE v0 — Durable Task Runtime + Model Router.
# Native dev: Ollama runs on the HOST (brew install ollama / ollama.ai) and
# the api reads OLLAMA_BASE_URL below — keep http://localhost:11434.
# Full containerized stack (`docker compose --profile engine up`): the
# compose `ollama` service (docker-compose.yml, profile "engine") replaces
# the host install — LEAVE OLLAMA_BASE_URL UNSET so compose defaults it to
# http://ollama:11434 (the service name), or set it to
# http://host.docker.internal:11434 to point the containerized api at the
# HOST install instead. OLLAMA_HOST_PORT maps the compose service's port.
# Default model: llama3.2 (fast, good structured-output compliance).
# Pull it once with:  ollama pull llama3.2
# ------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST_PORT=11434
DEFAULT_MODEL=llama3.2
# Per-request timeout for model calls (ms).
MODEL_TIMEOUT_MS=60000
# Hard cap on agent loop iterations (overridable per-task in the API).
ENGINE_MAX_STEPS=20
# Human-in-the-loop approval gate (Engine v0.1). Default false: only tools
# whose manifest declares `requiresApproval: true` (manifest v2) pause for
# approval. Set to true for FULLY-SUPERVISED mode: EVERY tool call pauses the
# task (status "paused", a pending_approval step recorded, nothing runs)
# until a human POSTs /api/engine/tasks/:id/approve or /reject.
ENGINE_REQUIRE_APPROVAL_ALL=false
# Hard per-task token ceiling (Engine v0.1 Task 3) — the "budget cap" the
# design promised. The worker accumulates every model call's usage and FAILS
# the task the moment the cumulative count crosses this. Overridable per task
# via `maxTokens` on POST /api/engine/tasks. Ollama reports usage on non-stream
# /api/chat responses (prompt_eval_count/eval_count); a provider that omits
# usage contributes 0 (ceiling is best-effort there). Dollar-cap seam: a paid
# provider would sum cost from its usage payload the same way — same
# enforcement point in the worker loop.
ENGINE_MAX_TOKENS_PER_TASK=100000
# Bounded retries for TRANSIENT model-call failures (Engine v0.1 Task 5):
# network blips, Ollama 5xx, and timeouts are retried up to this many times
# with small backoff (500ms * attempt, capped 2s) before the task fails. A
# 4xx (unknown model / bad request) is TERMINAL and fails immediately.
ENGINE_MODEL_RETRIES=3

# ------------------------------------------------------------------
# PHASE 2.0 — Observability.
# Prometheus metrics (GET /api/metrics). Disable with METRICS_ENABLED=false.
# OpenTelemetry tracing will follow (needs a Tempo/OTLP endpoint in compose).
METRICS_ENABLED=true

# ------------------------------------------------------------------
# ENGINE v0.3 — Cloud model providers (OPT-IN, $0 by default).
# Leave OPENROUTER_API_KEY UNSET and the engine runs on local Ollama
# only — nothing breaks, no crash, no hang. Set the key to unlock
# cloud models per task via the task's "model" field:
#   POST /api/engine/tasks { ..., "model": "openai/gpt-oss-120b" }
# OpenRouter is an aggregator — one key unlocks dozens of models
# (GPT-OSS, Qwen, DeepSeek, Claude, Gemini, and more).
# Permitted models / rate limits: https://openrouter.ai/settings
# ------------------------------------------------------------------
OPENROUTER_API_KEY=
# Base URL (only override for custom deployments):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model for OpenRouter tasks that don't specify one:
# OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------
# DeepSeek direct API (OPT-IN cloud provider, like OpenRouter).
# One key unlocks DeepSeek's own models. Models (2026-08): deepseek-v4-flash
# (default), deepseek-v4-pro. Docs: https://api-docs.deepseek.com
# Permitted models / pricing: https://api-docs.deepseek.com/quick_start/pricing/
# NOTE: this file is committed — NEVER paste a real key here. The real key
# lives ONLY in the git-ignored .env next to it.
DEEPSEEK_API_KEY=
# Base URL (only override for custom deployments):
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default model for DeepSeek tasks that don't specify one:
# DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
# Thinking mode: the engine's ReAct loop wants one JSON per turn, so thinking
# is DISABLED by default (fast + clean). Set to "enabled" to keep the model's
# chain-of-thought (its API default); optionally tune DEEPSEEK_REASONING_EFFORT
# (low|high|max).
# DEEPSEEK_THINKING=disabled
# DEEPSEEK_REASONING_EFFORT=high
# Derived-cost rates, USD per 1M tokens (DeepSeek returns no cost field).
# Defaults are the deepseek-v4-flash list prices; the announced peak/off-peak
# 2x policy is not modeled.
# DEEPSEEK_PRICE_INPUT_CACHE_HIT_PER_MT=0.0028
# DEEPSEEK_PRICE_INPUT_PER_MT=0.14
# DEEPSEEK_PRICE_OUTPUT_PER_MT=0.28

# ------------------------------------------------------------------
# PHASE 2.0 — Plugin sandboxing (2.7, OPT-IN process isolation).
# Plugins run IN-PROCESS by default (full Node privileges). Set the mode to
# "process" and list the plugins (or "*") whose tool invocations must run in
# a child Node process with a wall-clock timeout, a heap cap, a result-size
# cap, and crash containment — a bad plugin can never take down the api.
# The sandboxed context is MINIMAL (config + logger only): no DB, no events,
# no memory. Network isolation is NOT enforced on this host (no per-process
# network namespaces on Windows) — documented in MASTER_PLAN §9.
PLUGIN_SANDBOX_MODE=off
# Comma-separated plugin ids, or "*" for all (empty = none):
# PLUGIN_SANDBOX_PLUGINS=
# PLUGIN_SANDBOX_TIMEOUT_MS=30000
# PLUGIN_SANDBOX_MEMORY_MB=256
# PLUGIN_SANDBOX_MAX_RESULT_BYTES=1000000
# Custom runner script path (only for unusual layouts; auto-resolved otherwise):
# PLUGIN_SANDBOX_RUNNER=

# ------------------------------------------------------------------
# PHASE 2.0 — Worker as a separate process (2.8, OPT-IN).
# embedded (default): the api runs the engine loops in-process (as before).
# separate: the api serves REST + enqueues ONLY; the engine loops (agent
# worker, scheduler poll, supervisor sweep) run in the dedicated worker:
#   ENGINE_WORKER_MODE=separate node dist/worker-main.js   (boot-worker.sh)
# The worker sets ENGINE_IS_WORKER=true itself. Health honestly reports the
# loops as off in the api process when separate.
ENGINE_WORKER_MODE=embedded


# ------------------------------------------------------------------
# PHASE 2.0 — OpenTelemetry tracing (OPT-IN, fully additive).
# Leave OTEL_EXPORTER_OTLP_ENDPOINT EMPTY and the tracer is a NO-OP:
# zero spans, zero sockets, zero overhead. Set it to an OTLP/HTTP
# receiver to export spans (HTTP requests, engine task runs/steps,
# model calls, plugin tool invocations). Local Tempo from the
# federation overlay listens on :4318:
#   docker compose -f docker-compose.yml -f docker-compose.federation.yml \
#     --profile federation up -d tempo
# Then set: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# ------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name on the trace resource (defaults to constellation-api).
OTEL_SERVICE_NAME=constellation-api
# Override enable/disable. Default: enabled only when the endpoint is set.
# OTEL_TRACES_ENABLED=true

# ------------------------------------------------------------------
# ENGINE v0.4 — Scheduler / autonomous triggers.
# Recurring (cron) and event-triggered task schedules that auto-enqueue.
# Schedules are CRUD via /api/engine/schedules. The poll loop checks
# due cron schedules every SCHEDULER_POLL_INTERVAL_MS ms.
# ------------------------------------------------------------------
SCHEDULER_POLL_INTERVAL_MS=30000

# ------------------------------------------------------------------
# ENGINE v0.5 — Supervisor / 24-7 reliability.
# The SupervisorService poll loop detects tasks stuck in `running` with no
# progress for too long (orphaned job / worker stall), re-enqueues a genuinely
# stalled one once (resume-once), and marks a re-stale one as a `stalled` dead
# letter. ENGINE_SUPERVISOR_INTERVAL_MS = poll cadence; ENGINE_STALE_TASK_MS
# = how long with no step progress before a task is considered stale.
# ------------------------------------------------------------------
ENGINE_SUPERVISOR_INTERVAL_MS=30000
ENGINE_STALE_TASK_MS=300000

# ------------------------------------------------------------------
# P3 — SSO (OIDC). ALL OPTIONAL. Leave OIDC_ISSUER_URL unset and the
# platform behaves exactly as before: local JWT login only.
# Setting it activates a second token verifier that ALSO accepts tokens
# from your IdP; local logins keep working either way.
# ------------------------------------------------------------------
# e.g. http://localhost:8081/auth/realms/constellation
OIDC_ISSUER_URL=
# Expected `aud` claim. Unset = audience is not enforced (dev only).
OIDC_AUDIENCE=constellation
# Override only if discovery (/.well-known/openid-configuration) is unavailable.
OIDC_JWKS_URI=
# Claim names to read roles/permissions/email from (IdP-specific).
OIDC_ROLES_CLAIM=roles
OIDC_PERMISSIONS_CLAIM=permissions
OIDC_EMAIL_CLAIM=email
# Tolerated clock drift, JWKS cache TTL, and IdP fetch timeout.
OIDC_CLOCK_SKEW_SEC=60
OIDC_JWKS_CACHE_TTL_MS=600000
OIDC_JWKS_MIN_REFETCH_MS=30000
OIDC_HTTP_TIMEOUT_MS=5000

# ------------------------------------------------------------------
# P3 — Federated module registry
# ------------------------------------------------------------------
# Absolute path override; defaults to <repo>/config/modules.yaml.
FEDERATION_REGISTRY_PATH=

# ------------------------------------------------------------------
# BRAIN — Graphify memory / knowledge graph. Optional: the API boots
# and returns honest "brain not built yet" responses when these are unset.
# Docker Compose wires these automatically for the local sidecar.
# ------------------------------------------------------------------
GRAPHIFY_MCP_URL=
GRAPHIFY_GRAPH_PATH=
GRAPHIFY_BIN=graphify
GRAPHIFY_TIMEOUT_MS=30000
BRAIN_VAULT_DIR=
BRAIN_REPO_ROOT=
GRAPHIFY_MCP_HOST_PORT=8791
GRAPHIFY_MODE=code-only
GRAPHIFY_BACKEND=ollama
GRAPHIFY_MODEL=
GRAPHIFY_WATCH=1
GRAPHIFY_API_KEY=

# ------------------------------------------------------------------
# P3 — Federation stack (docker-compose.federation.yml, profile "federation").
# Only used by `make fed-up`. All dev-only defaults — CHANGE BEFORE ANY
# NON-LOCAL USE.
# ------------------------------------------------------------------
PROXY_HOST_PORT=8080
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=changeme
OPEN_WEBUI_HOST_PORT=3002
OPEN_WEBUI_AUTH=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
LANGFLOW_HOST_PORT=7860
LANGFLOW_AUTO_LOGIN=true
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=changeme
# Coolify is external to this stack (P5).
COOLIFY_URL=http://localhost:8000
